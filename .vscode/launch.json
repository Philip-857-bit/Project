{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wokwi GDB (t-a7670-wokwi)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/firmware/.pio/build/t-a7670-wokwi/firmware.elf",
      "cwd": "${workspaceFolder}/firmware",
      "MIMode": "gdb",
      "miDebuggerPath": "${env:USERPROFILE}\\.platformio\\packages\\toolchain-xtensa-esp32\\bin\\xtensa-esp32-elf-gdb.exe",
      "miDebuggerServerAddress": "localhost:3333",
      "stopAtEntry": true,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}

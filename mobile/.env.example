# Smart Fish Feeder Mobile App - Environment Variables
# Copy this file to .env and update the values for your environment
# 
# IMPORTANT: Never commit .env files with real credentials to version control!

# =============================================================================
# API Configuration
# =============================================================================
# Base URL for the backend API (without trailing slash)
API_BASE_URL=

# =============================================================================
# MQTT Configuration
# =============================================================================
# MQTT broker hostname
MQTT_HOST=mqtt.smartfishfeeder.com

# MQTT broker port (8883 for TLS, 1883 for non-TLS)
MQTT_PORT=8883

# =============================================================================
# Certificate Pinning (Security)
# =============================================================================
# SHA256 fingerprints of valid TLS certificates for certificate pinning
# Format: base64-encoded SHA256 hash of the certificate's DER encoding
# 
# To get the fingerprint from your server certificate:
#   openssl s_client -connect your-domain.com:443 < /dev/null 2>/dev/null | \
#   openssl x509 -outform DER | \
#   openssl dgst -sha256 -binary | \
#   openssl base64
#
# You should have at least 2 fingerprints (primary + backup) for certificate rotation
CERT_FINGERPRINT_1=YOUR_PRIMARY_CERTIFICATE_SHA256_FINGERPRINT_HERE
CERT_FINGERPRINT_2=YOUR_BACKUP_CERTIFICATE_SHA256_FINGERPRINT_HERE

# =============================================================================
# App Configuration
# =============================================================================
# Enable debug mode (set to false in production)
DEBUG_MODE=true

# Domain for certificate validation
API_DOMAIN=

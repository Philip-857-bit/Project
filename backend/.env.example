# Smart Fish Feeder Backend - Environment Variables Example
# Copy this file to .env and update the values for your environment

# =============================================================================
# Server Configuration
# =============================================================================
SFF_SERVER_HOST=0.0.0.0
SFF_SERVER_PORT=8080
SFF_SERVER_READ_TIMEOUT=30s
SFF_SERVER_WRITE_TIMEOUT=30s
SFF_SERVER_DEBUG=false

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# Option A: Full URI (recommended for cloud providers)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SFF_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
#
# Option B: Split fields
SFF_DATABASE_HOST=localhost
SFF_DATABASE_PORT=5432
SFF_DATABASE_USER=smartfeeder
SFF_DATABASE_PASSWORD=smartfeeder123
SFF_DATABASE_DBNAME=smart_fish_feeder
SFF_DATABASE_SSLMODE=disable
SFF_DATABASE_TIMEZONE=UTC

# =============================================================================
# Redis Configuration
# =============================================================================
# Option A: Full URI
# REDIS_URL=redis://:password@host:6379/0
# SFF_REDIS_URL=redis://:password@host:6379/0
#
# Option B: Split fields
SFF_REDIS_HOST=localhost
SFF_REDIS_PORT=6379
SFF_REDIS_PASSWORD=
SFF_REDIS_DB=0

# =============================================================================
# JWT Configuration
# =============================================================================
# IMPORTANT: Change this secret key in production!
SFF_JWT_SECRET_KEY=your-super-secret-key-change-in-production
SFF_JWT_ACCESS_TOKEN_DURATION=1h
SFF_JWT_REFRESH_TOKEN_DURATION=720h

# =============================================================================
# Logging Configuration
# =============================================================================
SFF_LOGGING_LEVEL=info
SFF_LOGGING_FORMAT=json

# =============================================================================
# Device Configuration
# =============================================================================
SFF_DEVICE_BINDING_CODE_EXPIRATION=10m
SFF_DEVICE_MAX_BINDING_ATTEMPTS=3

# =============================================================================
# Vision/Computer Vision Configuration (Local fallback)
# =============================================================================
SFF_VISION_STORAGE_PATH=./storage/videos
SFF_VISION_IMAGE_STORAGE_PATH=./storage/images
SFF_VISION_MAX_STORAGE_MB=1024
SFF_VISION_COMPRESSION_ON=true

# =============================================================================
# Cloudinary Configuration (Production media storage)
# Sign up at https://cloudinary.com - Free tier: 25GB storage, 25GB bandwidth
# =============================================================================
SFF_CLOUDINARY_CLOUD_NAME=your_cloud_name
SFF_CLOUDINARY_API_KEY=your_api_key
SFF_CLOUDINARY_API_SECRET=your_api_secret
SFF_CLOUDINARY_FOLDER=smart-fish-feeder
SFF_CLOUDINARY_ENABLED=true

# =============================================================================
# MQTT Configuration
# =============================================================================
SFF_MQTT_BROKER_URL=tcp://localhost:1883
SFF_MQTT_CLIENT_ID=smart-fish-feeder-backend
SFF_MQTT_USERNAME=
SFF_MQTT_PASSWORD=
SFF_MQTT_CLEAN_SESSION=true
SFF_MQTT_KEEP_ALIVE=60s
SFF_MQTT_CONNECT_TIMEOUT=30s
SFF_MQTT_RECONNECT_BACKOFF=5s
SFF_MQTT_MAX_RECONNECT=10
SFF_MQTT_QOS=1
SFF_MQTT_TLS_ENABLED=false

# =============================================================================
# BLE Provisioning Configuration
# =============================================================================
SFF_BLE_SESSION_TIMEOUT=30m
SFF_BLE_DEVICE_NAME_PREFIX=SmartFeeder_
SFF_BLE_MAX_ACTIVE_SESSIONS=5

# =============================================================================
# WebSocket Configuration
# =============================================================================
SFF_WEBSOCKET_PING_INTERVAL=54s
SFF_WEBSOCKET_WRITE_TIMEOUT=10s
SFF_WEBSOCKET_READ_TIMEOUT=60s
SFF_WEBSOCKET_MAX_MESSAGE_SIZE=512
SFF_WEBSOCKET_BUFFER_SIZE=256

# =============================================================================
# Offline Sync Configuration
# =============================================================================
SFF_OFFLINE_SYNC_MAX_RETRIES=5
SFF_OFFLINE_SYNC_RETRY_BACKOFF=30s
SFF_OFFLINE_SYNC_CLEANUP_INTERVAL=24h
SFF_OFFLINE_SYNC_DATA_RETENTION=168h
SFF_OFFLINE_SYNC_HIGH_PRIORITY_MIN=4
SFF_OFFLINE_SYNC_COMPRESSION_LEVEL=9

# =============================================================================
# Cellular Configuration
# =============================================================================
SFF_CELLULAR_DATA_LIMIT_MB=500
SFF_CELLULAR_COST_PER_MB=0.01
SFF_CELLULAR_LOW_SIGNAL_THRESHOLD=10
SFF_CELLULAR_REPORT_INTERVAL=1h
SFF_CELLULAR_ALERT_THRESHOLD_PCT=80.0

# =============================================================================
# Power Management Configuration
# =============================================================================
SFF_POWER_LOW_BATTERY_THRESHOLD=20.0
SFF_POWER_CRITICAL_BATTERY_THRESHOLD=10.0
SFF_POWER_SOLAR_MIN_VOLTAGE=12.0
SFF_POWER_BATTERY_FULL_VOLTAGE=14.4
SFF_POWER_BATTERY_EMPTY_VOLTAGE=11.0
SFF_POWER_POWER_CHECK_INTERVAL=5m

# Copy this file to .env or .env.local and fill values for Wokwi simulation.
# The firmware/scripts/load_wokwi_env.py script reads these values at build time.

# Wokwi network
WOKWI_DEFAULT_WIFI_SSID=Wokwi-GUEST
WOKWI_DEFAULT_WIFI_PASS=

# MQTT broker
WOKWI_DEFAULT_MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
WOKWI_DEFAULT_MQTT_USER=your_hive_user
WOKWI_DEFAULT_MQTT_PASS=your_hive_password

# MQTT options
MQTT_USE_TLS=1
MQTT_SKIP_CERT_VERIFY=1
# Optional port overrides
# MQTT_PORT=1883
# MQTT_PORT_TLS=8883
